# Local dev default (database.py falls back to this same value if unset).
# docker-compose.prod.yml sets this to the in-network service address
# (postgresql+psycopg://bank:bank@db:5432/bank_platform) instead - the
# backend container can't reach Postgres via "localhost".
DATABASE_URL=postgresql+psycopg://bank:bank@localhost:5432/bank_platform
GROQ_API_KEY=
DEEPSEEK_API_KEY=
# Meta Model API key (developer.meta.com) - validated Groq fallback, not
# active by default (paid, ~$20/mo contributor tier vs. Groq's free tier).
MUSE_API_KEY=
# Signs staff auth JWTs (Phase 6) - real IAM, replacing the earlier
# shared-secret ADMIN_API_KEY stopgap. Set to a long random string.
JWT_SECRET_KEY=
# Phase 7 (Edge Layer). Local dev defaults to "*" (unset) since the
# frontend dev server runs on a different port than the backend.
# docker-compose.prod.yml sets this to the real frontend origin - though
# with Traefik routing both under one domain (frontend at the root,
# backend under /api), production is same-origin and doesn't strictly
# need this at all; it's set anyway as defense in depth.
FRONTEND_ORIGIN=
# Traefik (Phase 7) - placeholders, swap in the real domain/email once
# you have them. Nothing local-dev-related depends on these.
DOMAIN=bank.example.com
ACME_EMAIL=admin@example.com

